#!/bin/bash
DEVICE="/dev/video0"
sleep 2

v4l2-ctl -d "$DEVICE" --set-fmt-video=width=1920,height=1080,pixelformat=MJPG
v4l2-ctl -d "$DEVICE" --set-parm=30
v4l2-ctl -d "$DEVICE" \
  --set-ctrl=auto_exposure=1 \
  --set-ctrl=exposure_time_absolute=555 \
  --set-ctrl=white_balance_automatic=0 \
  --set-ctrl=white_balance_temperature=4100 \
  --set-ctrl=gain=200 \
  --set-ctrl=backlight_compensation=0
