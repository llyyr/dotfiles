{
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "wlr/taskbar",
        "custom/recorder",
        "clock",
        "pulseaudio",
        "memory",
        "custom/amdgpu",
        "cpu",
        "temperature",
        "network",
        "custom/dnd"
    ],

    "ext/workspaces": {
        "on-click": "activate",
        "enable-bar-scroll": true
    },

    "wlr/taskbar": {
        "format": "{name}",
        "icon-size": 0,
        "tooltip": false,
        "all-outputs": false,
        "active-first": true,
        "active-only": true
    },

    "custom/recorder": {
        "interval": 1,
        "exec": "pgrep wl-screenrec >/dev/null && echo  || echo ''",
        "tooltip": false
    },

    "clock": {
        "timezones": ["", "Asia/Tokyo"],
        "format": "{:%a, %d %b. %r %Z}",
        "tooltip": false,
        "interval": 1,
        "on-click-right": "zenity --calendar --text=Calendar",
        "actions": {
            "on-click": "tz_up"
        }
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-bluetooth": "VOL {volume}% BT",
        "format-muted": "VOL MUTED",
        "on-click": "pavucontrol",
        "on-click-middle": "helvum",
        "on-click-right": "pactl set-sink-mute 77 toggle"
    },

    "memory": {
        "interval": 30,
        "format": "MEM {used:0.2f}GB",
        "unit": "GB"
    },

    "custom/amdgpu": {
        "interval": 1,
        "exec": "sh -c 'u=$(cat /sys/class/drm/card1/device/gpu_busy_percent 2>/dev/null || echo 0); v=$(cat /sys/class/drm/card1/device/mem_info_vram_used 2>/dev/null || echo 0); t=$(cat /sys/class/drm/card1/device/mem_info_vram_total 2>/dev/null || echo 1); p=$(awk -v v=\"$v\" -v t=\"$t\" \"BEGIN{printf \\\"%.0f\\\", (v/t)*100}\"); echo \"GPU ${u}% ${p}%\"'"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 1
    },

    "temperature": {
        "format": "TEMP {temperatureC}°",
        "thermal-zone": 1,
        "interval": 10
    },

    "network": {
        "interval": 1,
        "format-wifi": "WIFI DOWN {bandwidthDownBytes} UP {bandwidthUpBytes}",
        "format-ethernet": "ETH DOWN {bandwidthDownBytes} UP {bandwidthUpBytes}",
        "format-disconnected": "disconnected"
    },

    "custom/dnd": {
        "interval": "once",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "default": "default",
            "dnd": "dnd"
        },
        "exec": "printf '{\"alt\":\"%s\",\"tooltip\":\"mode: %s\"}' $(makoctl mode | grep -q dnd && echo dnd || echo default) \"$(makoctl mode | tail -1)\"",
        "on-click": "makoctl mode | grep -q dnd && makoctl mode -r dnd || makoctl mode -a dnd; pkill -RTMIN+11 waybar",
        "on-click-right": "makoctl restore",
        "signal": 11
    }
}
